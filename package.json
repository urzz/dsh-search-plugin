{
  "name": "dsh-search-plugin",
  "version": "0.1.2",
  "description": "Web search for DSH through /v1/alpha/search",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.4 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "check": "pnpm typecheck && pnpm test",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.4",
    "@deepseek-ai/dsh-web": "0.2.1-rc.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.4",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.4",
    "@deepseek-ai/dsh-api-settings-controller": "0.2.1-rc.4",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.4",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.4",
    "@deepseek-ai/dsh-credentials-local": "0.2.1-rc.4",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.4",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tool-web": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.4",
    "@deepseek-ai/dsh-web": "0.2.1-rc.4",
    "@deepseek-ai/dsh-web-fetch-http": "0.2.1-rc.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3"
  }
}
